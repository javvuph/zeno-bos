# Normalize line endings so editor differences don't produce whole-file diffs.
* text=auto eol=lf

*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.gradle text eol=lf
*.kts    text eol=lf

# Windows-native tooling expects CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.zip  binary
*.jar  binary
*.keystore binary
*.isar binary
